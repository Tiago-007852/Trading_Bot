# =======================================================
# TRADE AO / TRADE_AO_BOT - ENVIRONMENT CONFIGURATION
# =======================================================

# Telegram Bot Credentials
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Trading Mode & Live Protection (FASE 19)
# Values allowed: paper | testnet | live
# Default MUST BE 'paper'. Real live orders are ONLY sent when explicitly set to 'live'.
TRADING_MODE=paper

# Binance API Credentials (Sandbox / Testnet Dev Environment Only)
# NOTE: User API keys are stored individually per user in an encrypted vault.
BINANCE_DEV_API_KEY=
BINANCE_DEV_API_SECRET=
BINANCE_TESTNET=true

# Master Encryption Key (Used for encrypting per-user exchange credentials at rest)
APP_ENCRYPTION_KEY=

# Affiliate Partner URLs (Configurable official referral links)
AFFILIATE_BINANCE_URL=https://www.binance.com/register?ref=1058024469
AFFILIATE_BYBIT_URL=https://www.bybit.com/invite?ref=SEU_CODIGO_BYBIT

# AI / System Credentials
GEMINI_API_KEY=
